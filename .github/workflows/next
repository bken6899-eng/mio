            <button type="submit" class="btn btn-primary" id="formButton">
                تسجيل الدخول
            </button>

            <div id="formMessage" class="form-message" role="status"></div>

        </form>

        <div class="form-switch">
            <span id="switchText">ليس لديك حساب؟</span>
            <button type="button" id="switchMode">إنشاء حساب جديد</button>
