<!-- MODAL -->

<div class="modal" id="planModal" role="dialog"
     aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-content">
        <h3 id="modalTitle">تأكيد اختيار الخطة</h3>
        <p id="modalText"></p>
        <button class="btn btn-primary" id="confirmPlan">متابعة</button>
        <button class="btn btn-outline" id="closeModal">إغلاق</button>
    </div>
</div>

<footer>
<div class="container footer-content">

    <div class="logo">
        <div class="logo-icon">آ</div>
        <div>
            <h2 style="color:white">آفاق</h2>
            <small style="color:#c5d6ce">فضاء التعلم والبحث</small>
        </div>
    </div>

    <p>© <span id="year"></span> آفاق التعليمية. جميع الحقوق محفوظة.</p>
    <a href="#home">العودة إلى الأعلى ↑</a>

</div>
</footer>

<script>
"use strict";

// القائمة
const menuToggle = document.getElementById("menuToggle");
const navLinks = document.getElementById("navLinks");

menuToggle.addEventListener("click", () => {
    navLinks.classList.toggle("open");
});

document.querySelectorAll(".nav-links a").forEach(link => {
    link.addEventListener("click", () => {
        navLinks.classList.remove("open");
    });
});

// السنة
document.getElementById("year").textContent =
    new Date().getFullYear();

// عناصر الحساب
const accountForm = document.getElementById("accountForm");
const nameGroup = document.getElementById("nameGroup");
const typeGroup = document.getElementById("typeGroup");
const fullName = document.getElementById("fullName");
const email = document.getElementById("email");
const password = document.getElementById("password");
const accountType = document.getElementById("accountType");
const formMessage = document.getElementById("formMessage");

const formTitle = document.getElementById("formTitle");
const cardTitle = document.getElementById("cardTitle");
const cardDescription = document.getElementById("cardDescription");
const formButton = document.getElementById("formButton");
const switchText = document.getElementById("switchText");
const switchMode = document.getElementById("switchMode");
const logoutButton = document.getElementById("logoutButton");

let isRegister = false;
let selectedPlan = "free";

function showMessage(message, success = false) {
    formMessage.style.display = "block";
    formMessage.style.background = success ? "#e5f3e9" : "#fce8e6";
    formMessage.style.color = success ? "#257449" : "#a12622";
    formMessage.textContent = message;
}

function updateFormMode() {
    nameGroup.hidden = !isRegister;
    typeGroup.hidden = !isRegister;
    fullName.required = isRegister;

    formTitle.textContent = isRegister ?
        "إنشاء حساب جديد" : "تسجيل الدخول";

    cardTitle.textContent = isRegister ?
        "انضم إلى آفاق" : "مرحبًا بعودتك";

    cardDescription.textContent = isRegister ?
        "أنشئ حسابًا تجريبيًا لاستكشاف المنصة." :
        "أدخل بياناتك للوصول إلى العرض التجريبي.";

    formButton.textContent = isRegister ?
        "إنشاء الحساب" : "تسجيل الدخول";

    switchText.textContent = isRegister ?
        "لديك حساب بالفعل؟" : "ليس لديك حساب؟";

    switchMode.textContent = isRegister ?
        "تسجيل الدخول" : "إنشاء حساب جديد";

    formMessage.style.display = "none";
}

switchMode.addEventListener("click", () => {
    isRegister = !isRegister;
    updateFormMode();
});

// الحساب التجريبي
accountForm.addEventListener("submit", event => {
    event.preventDefault();

    const userEmail = email.value.trim();
    const userPassword = password.value;

    if (isRegister && fullName.value.trim().length < 2) {
        showMessage("يرجى إدخال الاسم الكامل.");
        return;
    }

    if (userPassword.length < 8) {
        showMessage("كلمة المرور يجب أن تتكون من 8 أحرف على الأقل.");
        return;
    }

    if (isRegister) {
        showMessage(
            "تم قبول بيانات العرض التجريبي. هذا ليس حسابًا حقيقيًا ولا تُحفظ بياناته.",
            true
        );
    } else {
        showMessage(
            "هذه نسخة عرض فقط. تسجيل الدخول الحقيقي يحتاج إلى خادم وقاعدة بيانات.",
            false
        );
    }
});

// اختيار الاشتراكات
const planNames = {
    free: "الخطة المجانية",
    monthly: "الخطة الشهرية",
    yearly: "الخطة السنوية"
};

const planPrices = {
    free: "0 دج",
    monthly: "500 دج",
    yearly: "4500 دج"
};

const planModal = document.getElementById("planModal");
const modalText = document.getElementById("modalText");

document.querySelectorAll(".subscribeButton").forEach(button => {
    button.addEventListener("click", () => {
        selectedPlan = button.dataset.plan;

        modalText.textContent =
            "لقد اخترت " + planNames[selectedPlan] +
            " بسعر " + planPrices[selectedPlan] +
            ". هذه عملية اختيار تجريبية وليست عملية دفع.";

        planModal.classList.add("show");
    });
});

document.getElementById("closeModal").addEventListener("click", () => {
    planModal.classList.remove("show");
});

document.getElementById("confirmPlan").addEventListener("click", () => {
    planModal.classList.remove("show");

    if (selectedPlan === "free") {
        document.getElementById("login").scrollIntoView({
            behavior: "smooth"
        });
        showMessage("تم اختيار الخطة المجانية في العرض التجريبي.", true);
    } else {
        document.getElementById("login").scrollIntoView({
            behavior: "smooth"
        });
        setTimeout(() => {
            showMessage(
                "اخترت " + planNames[selectedPlan] +
                ". تفعيل الاشتراك والدفع يحتاجان إلى خادم حقيقي.",
                true
            );
        }, 500);
    }
});

// إغلاق النافذة عند الضغط خارجها
planModal.addEventListener("click", event => {
    if (event.target === planModal) {
        planModal.classList.remove("show");
    }
});

// إغلاق النافذة بزر Escape
document.addEventListener("keydown", event => {
    if (event.key === "Escape") {
        planModal.classList.remove("show");
    }
});

// تهيئة
updateFormMode();
</script>

</body>
</html>
